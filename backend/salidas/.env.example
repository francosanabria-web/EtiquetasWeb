# Salidas - ejemplo de variables de entorno (copiar a .env o setear en _start_salidas.bat / supervisor_panol.ps1)
# Punto 2 - DB directo MariaDB panol.salida_historial (bajas en vivo)
SALIDAS_DB_ENABLED=1
# 0 = solo DB (recomendado prod), 1 = dual-write DB+Excel (backup transitorio)
SALIDAS_EXCEL_BACKUP=0
# No escribir Firestore al confirmar (decisión 2026-08-05)
SALIDAS_FIREBASE_WRITE=0
# Rutas planta (ajustar si Drive cambia letra, default G:\...)
# SALIDAS_PANOL_PATH=G:\Unidades compartidas\Mantenimiento\MANTENIMIENTO  OZLA 2024-2025\17. Pañol\pañol v5.0
# SALIDAS_MAESTRO_PATH=G:\Unidades compartidas\Mantenimiento\MANTENIMIENTO  OZLA 2024-2025\17. Pañol\pañol v5.0\master_codes.xlsx
# SALIDAS_WEB_PATH=G:\Unidades compartidas\Mantenimiento\MANTENIMIENTO  OZLA 2024-2025\17. Pañol\pañol v5.0\salidas_web
# DB MariaDB (XAMPP default)
SALIDAS_DB_HOST=127.0.0.1
SALIDAS_DB_PORT=3306
SALIDAS_DB_USER=root
SALIDAS_DB_PASSWORD=
SALIDAS_DB_NAME=panol
# Maestro solo lectura por defecto (no tocar master_codes de producción)
SALIDAS_MAESTRO_WRITABLE=0
# Diario: 0 = no genera salidas_DD-MM-AAAA.xlsx (export on-demand desde DB), 1 = genera
SALIDAS_ESCRIBIR_DIARIO=0
