# Servicio Reportes (:8017)
# REPORTES_PORT=8017
# REPORTES_MOVIMIENTOS_FILE=
# REPORTES_DATA_PATH=
# REPORTES_CORS_ORIGINS=http://localhost:5173,http://localhost:5180

# ── Mail diario / mensual (scaffold; DESACTIVADO) ──────────────────────────
# No enviar mails hasta poner ENABLED=1 + SMTP + destinatarios + tarea programada.
REPORTES_MAIL_DIARIO_ENABLED=0
REPORTES_MAIL_MENSUAL_ENABLED=0
REPORTES_MAIL_DIARIO_HORA=07:30
REPORTES_MAIL_MENSUAL_DIA=1
REPORTES_MAIL_MENSUAL_HORA=08:00
REPORTES_MAIL_DESTINATARIOS=

# SMTP (mismas vars que backend/email_service)
# PANOL_SMTP_HOST=smtp.gmail.com
# PANOL_SMTP_PORT=587
# PANOL_SMTP_USER=
# PANOL_SMTP_PASSWORD=
# PANOL_SMTP_FROM=

# Opcional: URL del email_service (hoy sin adjuntos; reportes usa SMTP local)
# REPORTES_EMAIL_SERVICE_URL=http://127.0.0.1:8020
