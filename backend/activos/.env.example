# =============================================================================
# Activos DB Configuration (.env.example)
# =============================================================================
# Copiar a .env y ajustar valores. Para desarrollo local, usar credenciales
# de tu instancia MariaDB local. Para produccion, variables del servidor.
# =============================================================================

# --- MariaDB DSN (mismo patron que backend/salidas/config.py) ---
ACTIVOS_DB_HOST=127.0.0.1
ACTIVOS_DB_PORT=3306
ACTIVOS_DB_USER=root
ACTIVOS_DB_PASSWORD=
ACTIVOS_DB_NAME=panol
ACTIVOS_DB_DSN=mysql+pymysql://root:@127.0.0.1:3306/panol

# --- Flag para modo DB-only (proximo paso de migracion) ---
# Cuando se quiera que el backend lea de DB en vez de Excel, poner en 1
# ACTIVOS_DB_ENABLED=0

# --- Puerto del servicio Activos ---
ACTIVOS_PORT=8016

# --- CORS ---
ACTIVOS_CORS_ORIGINS=http://localhost:5173,http://localhost:5180,http://127.0.0.1:5173,http://127.0.0.1:5180

# --- Ruta al Excel (solo para fallback cuando ACTIVOS_DB_ENABLED=0) ---
# ACTIVOS_DATA_PATH=G:\Unidades compartidas\Mantenimiento\MANTENIMIENTO  OZLA 2024-2025\17. Pañol\pañol v5.0
# KPIS_DATA_PATH= (hereda si ACTIVOS_DATA_PATH no está seteado)
